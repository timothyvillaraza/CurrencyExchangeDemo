@model CurrencyExchangeViewModel
<link rel="stylesheet" href="~/css/pages/CurrencyExchange.css" />

<form asp-action="CurrencyExchange" method="post" class="currency-exchange-form">
    <h1 class="row title">Currency Exchange Calculator</h1>

    <div class="row currency-input-container">
        <!-- Source Currency Section -->
        <div class="col currency-section">
            <label for="SourceCurrencyName" class="currency-label">Source Currency</label>
            <select asp-for="SourceCurrencyName" asp-items="Model.Currencies" class="form-control" id="source-currency-name"></select>
            <input asp-for="SourceCurrencyAmount" type="number" step="0.01" class="amount-input" id="source-currency-amount"/>
        </div>

        <!-- Seperator Section -->
        <div class="col conversion-arrow">
            <span>to</span>
        </div>

        <!-- Target Currency Section -->
        <div class="col currency-section">
            <label for="TargetCurrencyName" class="currency-label">Target Currency</label>
            <select asp-for="TargetCurrencyName" asp-items="Model.Currencies" class="form-control" id="target-currency-name"></select>
            <input asp-for="TargetCurrencyAmount" type="number" step="0.01" class="amount-input" id="target-currency-amount" />
        </div>
    </div>

    <!-- Date Picker Section -->
    <div class="date-section">
        <label for="Date" class="date-label">Date:</label><input asp-for="Date" type="date" class="date-picker" />
    </div>

    <!-- Rate Fetch Status -->
    <div class="row">
        <div class="rate-status" id="rate-status"></div>
    </div>
</form>

<div class="conversion-container">
    <h2>Conversions</h2>
    <p id="source-to-target-rate">usd To usd Rate: @Model.SourceToTargetRate</p>
    <p id="target-to-source-rate">usd To usd Rate: @Model.TargetToSourceRate</p>
    <h4><a href="https://github.com/timothyvillaraza/CurrencyExchangeDemo" target="_blank">Source Code (GitHub)</a></h4>
</div>

<!-- Scripts -->
<script src="~/js/pages/CurrencyExchange.js"></script>